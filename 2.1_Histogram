clc
clear
#f = [5 2 2 4; 7 2 1 6; 7 7 3 5; 7 2 0 5];
f = uint8(imread('pout.tif'));
#h = zeros(1,8);
h = zeros(1,256);
[row, col] = size(f);
for x = 1:1:row
for y = 1:1:col
    Temp = f(x,y);
    h(Temp+1) = h(Temp+1) + 1;
endfor
end
figure(1),imshow(uint8(f))
figure(2), bar(h)
###########################################
