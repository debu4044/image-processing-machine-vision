clc
clear
f = imread('pout.tif');
[row,col] = size(f)
alpha = 0.2
beta = 2
gamma = 0.5
r1 = 100
r2 = 180
s1 = alpha*r1
s2 = beta*(r2-r1)+s1
for x = 1:1:row
for y = 1:1:col
if 0<=f(x,y) && f(x,y)<=r1
      g(x,y) = alpha*f(x,y);
elseif r1<f(x,y) && f(x,y)<=r2
      g(x,y) = beta*(f(x,y)-r1)+s1;
else
      g(x,y) = gamma*(f(x,y)-r2)+s2;
endif
endfor
endfor
figure(1),imshow(uint8(f))
figure(2),imshow(uint8(g))
