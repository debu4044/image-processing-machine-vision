clc
clear
f1=double(imread('grey.tif'));
%f=[4 2 1 4; 7 8 5 6; 9 12 14 0;3 6 2 8]
[row,col]=size(f1);
for x=1:1:row
for y=1:1:col
    f(x,y)=f1(x,y)*(-1)^(x+y);
endfor
endfor
F=fft2(f);
Fmag=abs(F);
figure(1),imshow(uint8(f1))
figure(2),imagesc(log(1+Fmag))
#########################
Do = 40;
for u = 1:1:row
for v = 1:1:col
   D(u,v) = sqrt((u-(row/2))^2 + (v-(col/2))^2);
if D(u,v) <= Do
     H(u,v) = 0;
else
     H(u,v) = 1;
endif
endfor
end
figure(3), imshow(uint8(D))
figure(4), imshow(H)
figure(5), mesh(H)
#######################
G = F.*H;
g = ifft2(G);
figure(6),imshow(uint8(abs(g)))
