clc
clear all
f1=imread('grey.tif');
%f=[4 2 1 4; 7 8 5 6; 9 12 14 0;3 6 2 8]
[row,col]=size(f1);
for x=1:1:row
for y=1:1:col
    f(x,y)=f1(x,y)*(-1)^(x+y);
endfor
endfor
F=fft2(f);
Fmag=abs(F);
figure(1),imshow(uint8(f1)),title('Original grey image')
figure(2),imagesc(log(1+Fmag)),title('2D DFT centering image')
