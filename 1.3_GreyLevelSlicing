clc
clear
#f = [4 0 12; 6 11 15; 8 7 10];
f = imread('devesh_grey.tif');
[row,col] = size(f);
r1 = 40;
r2 = 150;
L = 256;
for x = 1:1:row
for y = 1:1:col
if r1<=f(x,y) && f(x,y)<=r2
      g1(x,y)=L-1;
      g2(x,y)=L-1;
else
      g1(x,y)=0;
      g2(x,y)=f(x,y);
endif
endfor
endfor
#g1,g2
figure(1),imshow(uint8(g1))
figure(2),imshow(uint8(g2))
